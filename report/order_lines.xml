<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="shokale_order_lines" name="Sale Order Data Shokale">
        <div class="row mb-2" t-attf-style="color:{{style.theme_txt_color if not style.transparent else style.text_color}};" t-if="doc.project_title">
            <div t-attf-style="background-color:{{style.theme_color if not style.transparent else 'transparent'}};">
                <span t-attf-style="font-size:{{int(style.body_font)+4}}px;">
                    <span t-field="doc.project_title"></span>
                </span>
            </div>
        </div>
        <!-- Is there a discount on at least one line? -->
        <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"></t>
        <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"></t>
        <!-- Is there tax on at least one line? -->
        <t t-set="display_taxes" t-value="any([y.tax_id for y in doc.order_line])"></t>
        <!-- To take care of columns when no discount -->
        <t t-set="col_span" t-value="8 if display_discount else 7"></t>
        <table class="table table-sm table-borderless" t-attf-style="color:{{style.text_color}};">
            <thead class="border-bottom">
                <tr t-attf-style="page-break-inside:avoid !important;font-size:{{int(style.body_font)}}px;background-color:{{style.theme_color if not style.transparent else 'transparent'}} !important;color:{{style.theme_txt_color if not style.transparent else style.text_color}};">
                    <!-- <th><i class="fa fa-list-ol"></i> Item</th> -->
                    <!-- <th t-if="style.show_img"><i class="fa fa-camera"></i> Image</th> -->
                    <th class="text-start"><i class="fa fa-th-large"></i> Descripción</th>
                    <th class="text-end" style="width:15%;"><i class="fa fa-sort-amount-asc"></i> Cantidad</th>
                    <th class="text-end" style="width:15%;"><i class="fa fa-tags"></i> Precio Unit.</th>
                    <th class="text-end" style="width:15%;" t-if="display_discount"><i class="fa fa-minus-square"></i> Discount(%)</th>
                    <!-- <th t-if="display_taxes" class="text-center"><i class="fa fa-pencil-square"/> Taxes</th> -->
                    <th class="text-end" style="width:15%;">
                        <i class="fa fa-money"></i>
                        <span>TOTAL</span>
                    </th>
                </tr>
            </thead>
            <tbody>
                <t t-set="current_subtotal" t-value="0"></t>
                <t t-set="item_count" t-value="0"></t>
                <t t-as="l" t-foreach="lines_to_report">
                    <t t-set="item_count" t-value="item_count + 1"></t>
                    <t t-set="current_subtotal" t-value="current_subtotal + l.price_subtotal"></t>
                    <tr t-att-class="'fw-bold o_line_section' if l.display_type == 'line_section' else 'fst-italic o_line_note' if l.display_type == 'line_note' else ''" t-attf-style="font-size:{{int(style.body_font)+4}}px;background-color:{{style.odd if (l_parity in 'odd' and not style.transparent) else (not style.transparent and style.even) or 'transparent'}}; page-break-inside: avoid">
                        <t t-if="not l.display_type">
                            <!-- <td><span t-esc="item_count"/></td> -->
                            <!-- <td t-if="style.show_img"><span itemprop="image" t-field="l.sudo().product_id.image_128" t-options='{"widget": "image"}'/></td> -->
                            <td>
                                <span t-field="l.name"></span>
                            </td>
                            <td class="text-end">
                                <span t-field="l.product_uom_qty"></span>
                                <span t-field="l.product_uom"></span>
                                <span t-if="l.product_packaging_id">(<span t-field="l.product_packaging_qty" t-options="{&quot;widget&quot;: &quot;integer&quot;}"></span> <span t-field="l.product_packaging_id"></span>)</span>
                            </td>
                            <td class="text-end">
                                <span t-field="l.price_unit" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"></span>
                            </td>
                            <td class="text-end" t-if="display_discount">
                                <span t-field="l.discount"></span>
                            </td>
                            <!-- <td t-if="display_taxes" class="text-center">
                                <span t-esc="', '.join(map(lambda x: (x.description or x.name), l.tax_id))"/>
                            </td> -->
                            <td class="text-end" t-if="not l.is_downpayment">
                                <span t-field="l.price_subtotal"></span>
                            </td>
                        </t>
                        <t t-elif="l.display_type == 'line_section'">
                            <td t-att-colspan="col_span">
                                <span t-field="l.name"></span>
                            </td>
                            <t t-set="current_section" t-value="l"></t>
                            <t t-set="current_subtotal" t-value="0"></t>
                            <t t-set="item_count" t-value="0"></t>
                        </t>
                        <t t-elif="l.display_type == 'line_note'">
                            <td t-att-colspan="col_span">
                                <span t-field="l.name"></span>
                            </td>
                            <t t-set="item_count" t-value="item_count - 1"></t>
                        </t>
                    </tr>
                    <t t-if="current_section and (l_last or doc.order_line[l_index+1].display_type == 'line_section') and not l.is_downpayment">
                        <tr class="is-subtotal text-end">
                            <td t-att-colspan="col_span">
                                <strong class="mr16">Subtotal</strong>
                                <span t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}" t-out="current_subtotal"></span>
                            </td>
                        </tr>
                    </t>
                </t>
            </tbody>
        </table>
        <div class="clearfix" style="page-break-inside: avoid !important;">
            <div class="row" id="total" name="total">
                <div t-attf-class="#{'col-4' if report_type != 'html' else 'col-sm-7 col-md-5'} ms-auto">
                    <table class="table table-sm table-borderless border-top" t-attf-style="color:{{style.text_color}};">
                        <!-- Tax totals -->
                        <t t-set="tax_totals" t-value="doc.tax_totals"></t>
                        <t t-call="account.document_tax_totals"></t>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-6 float-left" style="padding-left:0px; padding-right:0px; page-break-inside: avoid !important;">
            <!-- <p t-if="doc.payment_term_id.note">
                <span t-field="doc.payment_term_id.note"/>
            </p> -->
            <p t-if="doc.incoterm">
                <strong>Shipping:</strong>
                <span t-field="doc.incoterm"></span>
            </p>
            <!-- <p id="payment_term" t-if="not doc.payment_term_id and doc.partner_id.property_payment_term_id">
                <span t-field="doc.partner_id.property_payment_term_id.note"/>
            </p> -->
            <p t-if="doc.fiscal_position_id.note">
                <strong>Fiscal Position Remark:</strong>
                <span t-field="doc.fiscal_position_id.note"></span>
            </p>
            <p t-if="style.aiw_report">
                <strong>Amount in Words:</strong>
                <span style="text-decoration:underline;" t-field="doc.amount_words"></span>
            </p>
        </div>
        <div class="row mt32" name="signature" style="page-break-inside: avoid !important;" t-if="doc.signature">
            <div class="offset-8 col-4">
                <strong>Signature</strong>
            </div>
            <div class="offset-8 col-4">
                <img style="max-height: 4cm; max-width: 8cm;" t-att-src="image_data_uri(doc.signature)"></img>
            </div>
            <div class="offset-8 col-4 text-center">
                <p t-field="doc.signed_by"></p>
            </div>
        </div>
        <div class="col-12 float-left" style="padding-left:0px; padding-right:0px; page-break-inside: avoid !important;" t-if="doc.sale_order_option_ids and doc.state in ['draft', 'sent']">
            <t t-set="has_option_discount" t-value="any(doc.sale_order_option_ids.filtered(lambda o: doc.discount != 0.0))"></t>
            <h4>
                <span>Options</span>
            </h4>
            <table class="table table-sm" t-attf-style="color:{{style.text_color}};">
                <thead t-attf-style="background-color:{{style.theme_color if not style.transparent else 'transparent'}} !important; page-break-inside: avoid; color:{{style.theme_txt_color if not style.transparent else style.text_color}};">
                    <tr t-attf-style="page-break-inside: avoid !important; border-bottom: 1px solid {{style.text_color}} !important;font-size:{{int(style.body_font)+2}}px;">
                        <th class="text-left"><i class="fa fa-th-large"></i> Description</th>
                        <th class="text-left" t-if="has_option_discount">Discount(%)</th>
                        <th class="text-end"><i class="fa fa-tags"></i> Unit Price</th>
                    </tr>
                </thead>
                <tbody class="sale_tbody">
                    <tr t-as="opt" t-attf-style="background-color:{{style.odd if (opt_parity in 'odd' and not style.transparent) else (not style.transparent and style.even) or 'transparent'}}; page-break-inside: avoid" t-foreach="doc.sale_order_option_ids">
                        <td>
                            <span t-field="opt.name"></span>
                        </td>
                        <td t-if="has_option_discount">
                            <strong t-if="opt.discount != 0.0"><t t-esc="((opt.discount % 1) and '%s' or '%d') % opt.discount"></t>%</strong>
                        </td>
                        <td>
                            <strong class="text-end">
                                <div t-att-class="opt.discount and 'text-danger' or None" t-att-style="opt.discount and 'text-decoration: line-through' or None" t-field="opt.price_unit" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"></div>
                                <div t-if="opt.discount">
                                    <t t-esc="'%.2f' % ((1 - opt.discount / 100.0) * opt.price_unit)"></t>
                                </div>
                            </strong>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>
</odoo>
